# GOindexer Configuration
# Copy this file to .env and fill in your values

# Starting URL for the crawler
STARTING_URL=https://en.wikipedia.org/wiki/Main_Page

# Number of concurrent worker threads
NUM_WORKERS=10

# Max workers that may hold an active claim on different hosts under the same
# registrable domain (eTLD+1), e.g. wikipedia.org. Remaining workers pick other sites.
MAX_WORKERS_PER_SITE=5

# URL dedupe: by default only junk query params are stripped (utm_*, returnto, fbclid, …).
# Set to true to remove the entire query string on every URL (can break index.php?title=… sites).
STRIP_ALL_URL_QUERY=false

# Default crawl delay in milliseconds (if not specified in robots.txt)
DEFAULT_CRAWL_DELAY_MS=2000

# If you want to save the pages crawled, set this to true
SAVE_DATA=false

# ============================================
# ANALYTICS CONFIGURATION
# ============================================
# Enable analytics module to track domain relationships
# Set to true to analyze how different sites connect to each other
ANALYTICS=true

# How often to run analytics (in seconds)
# Default: 3600 (1 hour) - Only processes top 100 domains for efficiency
FREQUENCY=3600

# ============================================
# API CONFIGURATION
# ============================================
# Enable API service
API=true

# API Mode: GET or POST
# GET  - Host a REST API server to query data
# POST - Send data to a remote endpoint periodically
REQUEST_MODE=GET

# For GET mode: Port to listen on
PORT=8080

# For POST mode: Destination endpoint URL
DESTINATION=http://localhost:3000/api/indexer

# How often to send data in POST mode (in seconds)
# Default: 300 (5 minutes)
API_FREQUENCY=300

# ============================================
# API ENDPOINTS (GET mode)
# ============================================
# When API=true and REQUEST_MODE=GET, the following endpoints are available:
#
# GET http://localhost:PORT/stats
#   - Returns total URLs scraped, domains discovered, etc.
#
# GET http://localhost:PORT/domains
#   - Returns statistics for all domains with link counts
#
# GET http://localhost:PORT/domain/{domain}/links?limit=50
#   - Returns top N domains that {domain} links to
#   - limit parameter is optional (default: 50)
#
# GET http://localhost:PORT/graph?min_links=1
#   - Returns network graph data for visualization (nodes and edges)
#   - min_links parameter filters nodes/edges by minimum link count
#   - Use this for drawing interconnected orbs on your website

# ============================================
# POST MODE DATA FORMAT
# ============================================
# When API=true and REQUEST_MODE=POST, data is sent as JSON to DESTINATION:
# {
#   "total_urls_scraped": 12345,
#   "total_domains": 678,
#   "domains": [
#     {
#       "domain": "example.com",
#       "urls_discovered": 150,
#       "urls_fetched": 145,
#       "outgoing_links": 500,
#       "incoming_links": 200,
#       "unique_targets": 50
#     }
#   ],
#   "graph": {
#     "nodes": [
#       {
#         "id": "example.com",
#         "domain": "example.com",
#         "url_count": 145,
#         "link_count": 500
#       }
#     ],
#     "edges": [
#       {
#         "source": "example.com",
#         "target": "another.com",
#         "link_count": 25
#       }
#     ]
#   },
#   "timestamp": "2026-04-16T12:00:00Z"
# }

